<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<HBox fx:id="root" alignment="CENTER_LEFT" minHeight="50.0" prefHeight="50.0" maxHeight="50.0" spacing="8.0" styleClass="list-item" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.ControllerListItem">
   <padding>
      <Insets bottom="3.0" left="5.0" right="5.0" top="3.0" />
   </padding>
   <children>
      <StackPane alignment="CENTER" minWidth="56.0" prefWidth="56.0" maxWidth="56.0">
         <children>
            <ImageView fx:id="img" fitHeight="44.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>
      <Label fx:id="title" maxWidth="1.7976931348623157E308" text="Title" HBox.hgrow="ALWAYS" />
   </children>
</HBox>
